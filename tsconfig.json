{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.AsyncIterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "sourceMap": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "resolveJsonModule": true
  }
}
