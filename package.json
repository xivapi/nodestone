{
  "name": "@xivapi/nodestone",
  "version": "0.2.8",
  "description": "Node.js Lodestone scraper",
  "keywords": ["bun", "deno", "ffxiv", "lodestone", "node", "xivapi"],
  "homepage": "https://github.com/xivapi/nodestone",
  "bugs": "https://github.com/xivapi/nodestone/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/xivapi/nodestone.git"
  },
  "license": "MIT",
  "author": "miichom <hello@cammy.xyz> (https://cammy.xyz/)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "tsdown",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "test": "vitest --coverage"
  },
  "dependencies": {
    "bottleneck": "^2.19.5",
    "consola": "^3.4.2",
    "linkedom": "^0.18.13",
    "picocolors": "^1.1.1",
    "std-env": "^4.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  }
}
